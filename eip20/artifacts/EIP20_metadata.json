					{
						"details": "The caller account is not authorized to perform an operation."
					}
				]
			},
			"events": {
				"Approval(address,address,uint256)": {
					"details": "授权事件。",
					"params": {
						"_owner": "拥有代币的账户地址。",
						"_spender": "被授权可以转移代币的账户地址。",
						"_value": "授权转移的代币数量。"
					}
				},
				"Transfer(address,address,uint256)": {
					"details": "代币转移事件。",
					"params": {
						"_from": "发送代币的账户地址。",
						"_to": "接收代币的账户地址。",
						"_value": "转移的代币数量。"
					}
				}
			},
			"kind": "dev",
			"methods": {
				"allowance(address,address)": {
					"details": "查询指定地址对另一个指定地址的授权数量",
					"params": {
						"_owner": "授权的地址",
						"_spender": "被授权的地址"
					},
					"returns": {
						"_0": "剩余的授权数量"
					}
				},
				"approve(address,uint256)": {
					"details": "授权指定地址使用调用者的代币",
					"params": {
						"_spender": "被授权的地址",
						"_value": "授权的代币数量"
					},
					"returns": {
						"_0": "授权是否成功，始终返回true"
					}
				},
				"balanceOf(address)": {
					"details": "查询指定地址的代币余额",
					"params": {
						"_owner": "查询余额的地址"
					},
					"returns": {
						"_0": "该地址的代币余额"
					}
				},
				"burn(uint256)": {
					"details": "销毁代币，减少总供应量",
					"params": {
						"_amount": "销毁的代币数量"
					}
				},
				"decreaseAllowance(address,uint256)": {
					"details": "减少对指定地址的授权额度",
					"params": {
						"_spender": "被授权的地址",
						"_subtractedValue": "减少的授权代币数量"
					},
					"returns": {
						"_0": "操作是否成功，始终返回true"
					}
				},
				"increaseAllowance(address,uint256)": {
					"details": "增加对指定地址的授权额度",
					"params": {
						"_addedValue": "增加的授权代币数量",
						"_spender": "被授权的地址"
					},
					"returns": {
						"_0": "操作是否成功，始终返回true"
					}
				},
				"mint(address,uint256)": {
					"details": "增发代币，增加总供应量，只有合约所有者可以调用",
					"params": {
						"_amount": "增发的代币数量",
						"_to": "接收增发代币的地址"
					}
				},
				"owner()": {
					"details": "Returns the address of the current owner."
				},
				"renounceOwnership()": {
					"details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
				},
				"totalSupply()": {
					"details": "代币的总供应量。"
				},
				"transfer(address,uint256)": {
					"details": "从当前调用者地址向指定地址转账代币",
					"params": {
						"_to": "接收代币的地址",
						"_value": "转账的代币数量"
					},
					"returns": {
						"_0": "转账是否成功，始终返回true"
					}
				},
				"transferFrom(address,address,uint256)": {
					"details": "从指定地址向另一个指定地址转账代币，前提是调用者已经被授权",
					"params": {
						"_from": "转出代币的地址",
						"_to": "接收代币的地址",
						"_value": "转账的代币数量"
					},
					"returns": {
						"_0": "转账是否成功，始终返回true"
					}
				},
				"transferOwnership(address)": {
					"details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
				}
			},
			"title": "Enhanced EIP20 代币合约",
